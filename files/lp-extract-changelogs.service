[Unit]
Description=Extract Ubuntu package changelogs from Launchpad
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/lp-extract-changelogs \
    --cache-dir /var/cache/ubuntu-changelogs/lp-cache \
    --state-dir /var/lib/ubuntu-changelogs \
    --output-dir /var/www/changelogs.ubuntu.com/changelogs
